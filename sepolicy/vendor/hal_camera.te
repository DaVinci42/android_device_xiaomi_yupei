type hal_aidlbgservice_service, hal_service_type, protected_service, service_manager_type;
type hal_camera_aon_service, hal_service_type, protected_service, service_manager_type;
type hal_dynamic_camera_service, hal_service_type, protected_service, service_manager_type;
type vendor_intentaware_service, hal_service_type, protected_service, service_manager_type;

set_prop(hal_camera, vendor_camera_sensor_prop)
set_prop(hal_camera_default, vendor_camera_p3enable_prop)
set_prop(hal_camera_default, vendor_camera_xdrversion_prop)
get_prop(hal_camera_default, bpf_progs_loaded_prop)

r_dir_file(hal_camera_default, camera_persist_file)
r_dir_file(hal_camera_default, mnt_vendor_file)

hal_client_domain(hal_camera_default, hal_power)

allow hal_camera_client hal_aidlbgservice_service:service_manager find;
allow hal_camera_client hal_camera_aon_service:service_manager find;
allow hal_camera_client hal_dynamic_camera_service:service_manager find;
allow hal_camera_client vendor_intentaware_service:service_manager find;
allow hal_camera_client hal_quickcamera_service:service_manager find;
allow { platform_app platform_app_36 } hal_aidlbgservice_service:service_manager find;
binder_call({ platform_app platform_app_36 }, hal_camera_default)
binder_call(hal_camera_default, { platform_app platform_app_36 })
get_prop({ platform_app platform_app_36 }, vendor_audio_prop)
get_prop({ platform_app platform_app_36 }, vendor_camera_p3enable_prop)
get_prop({ platform_app platform_app_36 }, vendor_displayfeature_prop)
dontaudit { platform_app platform_app_36 } vendor_hal_qspmhal_service:service_manager find;
dontaudit { platform_app platform_app_36 } vendor_miev_device:chr_file { open write };
allow hal_camera_default camlog_device:chr_file { ioctl open read write };
allow hal_camera_default cgroup:file r_file_perms;
allow hal_camera_default proc_meminfo:file r_file_perms;
allow hal_camera_default proc_pressure_cpu:file r_file_perms;
allow hal_camera_default proc_pressure_io:file r_file_perms;
allow hal_camera_default proc_pressure_mem:file { getattr open read write };
allow hal_camera_default vendor_sysfs_kgsl:file r_file_perms;
allow hal_camera_default vendor_sysfs_kgsl:lnk_file r_file_perms;
allow hal_camera_default self:capability { fowner ipc_lock };
allow hal_camera_default sys_thermal_flash_state:file { w_file_perms getattr };
allow hal_camera_default sys_thermal_torch_real_level:file { w_file_perms getattr };
allow hal_camera_default sysfs_csiphy_umd_paras:file { open read write };
allow hal_camera_default vendor_camera_data_file:sock_file { create getattr open read setattr unlink write };
allow hal_camera_default vendor_displayfeature_device:chr_file { ioctl open read };
allow hal_camera_default vendor_bsp_data_log_file:dir rw_dir_perms;
allow hal_camera_default vendor_bsp_data_log_file:file create_file_perms;
allow hal_camera_default vendor_miev_device:chr_file { open write };
dontaudit hal_camera_default shell_data_file:dir search;
dontaudit hal_camera_default system_data_file:dir search;
add_service(hal_camera_server, hal_aidlbgservice_service)
add_service(hal_camera_server, hal_camera_aon_service)
add_service(hal_camera_server, hal_dynamic_camera_service)
add_service(hal_camera_server, vendor_intentaware_service)
allow hal_camera_server hal_quickcamera_service:service_manager { add find };
allow hal_camera_server vendor_sysfs_xm_power:dir r_dir_perms;
allow hal_camera_server vendor_sysfs_xm_power:file rw_file_perms;
